# Copie para .env e preencha. NUNCA commitar .env com valores reais.
NODE_ENV=development
PORT=3000

# PostgreSQL (Neon serverless compatível)
DATABASE_URL=postgres://usuario:senha@host/db?sslmode=require
# Tuning opcional do pool (defaults: 10 conexões, 5000ms de timeout de conexão)
# PG_POOL_MAX=10
# PG_CONN_TIMEOUT_MS=5000

# JWT — segredo forte, T_exp curto. Refresh: 7 dias por default.
JWT_SECRET=troque-por-um-segredo-forte-de-32+-bytes
JWT_EXP_SEGUNDOS=900
# JWT_REFRESH_EXP_SEGUNDOS=604800

# CORS — allowlist separada por vírgula (painel + app do cliente). Sem '*' em produção.
CORS_ORIGINS=http://localhost:5173,https://painel.summerdrinks.app,https://app.summerdrinks.app

# Rate limit da borda pública (por IP+tenant, janela em ms)
PUBLIC_RATE_MAX=5
PUBLIC_RATE_JANELA_MS=60000
# PUBLIC_RATE_PEDIDO_MAX=20
# PUBLIC_RATE_EVENTO_MAX=5
# PUBLIC_RATE_AGENDA_STATUS_MAX=120

# Rate limit do /auth (login/refresh, por IP)
# AUTH_RATE_MAX=10
# AUTH_RATE_JANELA_MS=60000

# Seed (scripts/seed.ts) — senha do admin 'gestao' do tenant summer
# SEED_ADMIN_SENHA=defina-uma-senha-forte

# Notificações (worker de outbox → WhatsApp do cliente)
# 'fake' = in-memory (dev/test). 'green' = Green API real (exige GREEN_API_*).
NOTIF_DRIVER=fake
NOTIF_WORKER=true
# GREEN_API_BASE_URL=https://api.green-api.com   # ou a URL da sua instância, ex.: https://1103.api.green-api.com
# GREEN_API_ID_INSTANCE=1103000001
# GREEN_API_TOKEN=cole-o-apiTokenInstance-da-instancia
