# === Backend (de onde vêm os pedidos) ===
API_URL=https://summerdrinks-atendimento.onrender.com
TENANT=summer

# Usuário dedicado do agente (crie em Ajustes → Usuários; papel pdv ou gestao).
PRINTER_USER=impressora
PRINTER_PASS=troque-esta-senha

# === Impressora Tanca TP-620 na REDE (Ethernet) ===
# IP fixo da impressora na rede local + porta RAW (9100 é o padrão da Tanca).
IMPRESSORA_HOST=192.168.0.50
IMPRESSORA_PORT=9100

# === Comportamento ===
POLL_MS=4000            # de quanto em quanto tempo checa pedidos novos
COLUNAS=48              # 48 p/ bobina 80mm (Font A); use 32 se for 58mm
CORTE=parcial           # parcial (grudado no centro) | total | nenhum
TRAILER=Summer Drinks

# Modo teste: NÃO imprime; grava os bytes em saida-teste.bin e mostra a prévia.
DRY_RUN=false
